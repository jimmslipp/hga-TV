<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.HGA" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_carbon</item>
        <item name="android:colorBackground">@color/carbon_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/hga_accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/carbon_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/carbon_bg</item>
    </style>

    <style name="Theme.HGA.Splash">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <style name="Theme.HGA.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>


    <style name="Theme.HGA.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/carbon_surface</item>
        <item name="colorAccent">@color/hga_accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowMinWidthMajor">55%</item>
        <item name="android:windowMinWidthMinor">70%</item>
    </style>

    <!-- Reusable text styles -->
    <style name="Hga.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing" tools:targetApi="21">0.02</item>
    </style>

    <style name="Hga.Body" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Hga.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <style name="Hga.Button" parent="">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">26dp</item>
        <item name="android:paddingRight">26dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
