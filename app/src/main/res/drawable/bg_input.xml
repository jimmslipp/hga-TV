<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/carbon_surface_alt" />
            <stroke android:width="2dp" android:color="@color/hga_accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/carbon_surface" />
            <stroke android:width="1dp" android:color="@color/carbon_line" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
